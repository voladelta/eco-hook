# Compiler files
cache/
out/

# Dependency-root prose may be omitted; nested source directories named `docs` remain tracked.
/vendor/*/docs/

# Ignores development (and goerli) broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/*/5/
/broadcast/**/dry-run/

# Local environment files
.env
.env.*
!.env.example

# Disposable local evidence
.devnet/
reports/

# Local deployment manifests; commit only reviewed examples
deployments/*.local.json

# Resumable agent state
.workflow/
